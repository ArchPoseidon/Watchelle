# Copy this file to .env.local and fill in what you have. Every integration
# below has a dev-only fallback (sample titles, rule-based recommendations,
# no streaming links, in-memory storage) so the app runs and is fully
# testable in a browser before any of these exist — see README.md.

# --- Supabase --------------------------------------------------------------
# Create a project at https://supabase.com, then run supabase/schema.sql in
# its SQL editor. Project Settings -> API has all three values below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude) -----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- TMDB --------------------------------------------------------------------
# https://www.themoviedb.org/settings/api (the "API Key (v3 auth)" value)
TMDB_API_KEY=

# --- RapidAPI: Streaming Availability (movieofthenight) ----------------------
# https://rapidapi.com/movieofthenight/api/streaming-availability
RAPIDAPI_KEY=
RAPIDAPI_STREAMING_HOST=streaming-availability.p.rapidapi.com
